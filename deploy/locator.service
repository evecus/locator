[Unit]
Description=Locator location-sharing server
After=network.target

[Service]
User=locator
ExecStart=/usr/local/bin/locator-server serve --addr 127.0.0.1:8080 --db /var/lib/locator/locator.db
Restart=on-failure
RestartSec=3

# 加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/locator
PrivateTmp=true

[Install]
WantedBy=multi-user.target
